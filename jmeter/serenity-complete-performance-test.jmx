                <stringProp name="Argument.value">{
  "userId": 1,
  "medicationId": 1,
  "status": "TAKEN",
  "takenAt": "${__time(yyyy-MM-dd'T'HH:mm:ss,)}"
}</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree/>
        
        <!-- DOSE-08: Statistiques -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="DOSE-08: GET /api/doses/stats/1">
          <stringProp name="HTTPSampler.path">/api/doses/stats/1</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
        </HTTPSamplerProxy>
        <hashTree/>
      </hashTree>

      <!-- ═══════════════════════════════════════════════════════════════════ -->
      <!-- GROUPE 5: PROFIL ET RECOMMANDATIONS (PROF/REC) - 50 utilisateurs    -->
      <!-- ═══════════════════════════════════════════════════════════════════ -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="👤 [PROF/REC] Profil et Recommandations (50 users)">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">10</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">50</stringProp>
        <stringProp name="ThreadGroup.ramp_time">30</stringProp>
      </ThreadGroup>
      <hashTree>
